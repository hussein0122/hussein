# ShortsPilot AR — local configuration template
LANGUAGE=ar
NICHES=حقائق علمية,تاريخ,فضاء,تكنولوجيا,ألغاز,حيوانات,معلومات عامة
TOPIC_SOURCES=niche
SCRIPT_STYLE=auto
SCRIPT_REVIEW=rewrite
SCRIPT_REVIEW_ROUNDS=1
SCRIPT_TARGET_SCORE=80
TARGET_SECONDS=35
CHANNEL_NAME=ShortsPilot AR
AUDIENCE=الجمهور العربي

# Gemini API: use a Google AI Studio free-tier API key.
# Never commit a real key. Do not enable paid billing without explicit approval.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=

# Free Arabic speech generation
TTS_ENGINE=edge
TTS_VOICE=ar-EG-SalmaNeural
TTS_RATE=+5%

# Free stock footage APIs (at least one key is needed for real visuals)
VISUAL_SOURCES=pexels,pixabay
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Vertical Shorts editing
ASPECT=9:16
RESOLUTION=1080x1920
FPS=30
CAPTION_STYLE=karaoke
CAPTION_POSITION=center
CAPTION_MAX_WORDS=3
COLOR_GRADE=vivid
TRANSITION=random
SOUND_EFFECTS=true
VOICE_ENHANCE=true
MUSIC_VOLUME=0.10
END_CTA=تابعنا للمزيد

# Safe test defaults: uploads stay private until reviewed.
UPLOAD=true
YT_PRIVACY=private
YT_DAILY_LIMIT=1
SYNTHETIC_MEDIA=true
KEEP_VIDEOS=true
OUTPUT_DIR=output_videos
TIMEZONE=Africa/Cairo

# Set only after the first video is approved and the production schedule is enabled.
PUBLISH_TIMES=09:00,14:00,19:00

# Comment replies stay disabled until separately tested and authorized.
AUTO_REPLY_ENABLED=false
AUTO_REPLY_DAILY_LIMIT=20
AUTO_REPLY_LANGUAGE=ar
