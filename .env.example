# ShortsPilot AR — local configuration template
LANGUAGE=ar
NICHES=غرائب الحيوانات,ماذا لو؟,أسرار جسم الإنسان,ألغاز علمية,ظواهر طبيعية غريبة,أسرار الفضاء,تاريخ غامض,اختراعات غيرت العالم,أسرار المحيطات,حقائق مذهلة
TOPIC_SOURCES=search:3,niche:5,reddit:2,trending:1,wikipedia:1
TRENDS_GEO=EG
SCRIPT_STYLE=auto
SCRIPT_REVIEW=rewrite
SCRIPT_REVIEW_ROUNDS=1
SCRIPT_TARGET_SCORE=80
TARGET_SECONDS=35
CHANNEL_NAME=ShortsPilot AR
AUDIENCE=الجمهور العربي

# Google AI Studio free tier only. Never enable paid billing for this project.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=

# Free Egyptian Arabic neural voice
TTS_ENGINE=edge
TTS_VOICE=ar-EG-ShakirNeural
TTS_RATE=+2%

# Pixabay visuals; add Pexels only after a PEXELS_API_KEY is configured.
VISUAL_SOURCES=pixabay,pixabay-photos
PIXABAY_API_KEY=
# PEXELS_API_KEY=

# YouTube OAuth — all three values must belong to the same OAuth Web Client.
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
# Refresh token must be authorized with all three scopes:
# youtube.upload, youtube.readonly, yt-analytics.readonly

# Video rendering
ASPECT=9:16
RESOLUTION=1080x1920
FPS=30
CAPTION_STYLE=karaoke
CAPTION_POSITION=lower
CAPTION_UPPERCASE=false
CAPTION_MAX_WORDS=3
COLOR_GRADE=cinematic
TRANSITION=random
TRANSITION_SECONDS=0.28
MAX_SHOT_SECONDS=3.2
KEN_BURNS=true
TRANSITION=none
SOUND_EFFECTS=true
VOICE_ENHANCE=true
MUSIC_VOLUME=0.08
END_CTA=تابعنا للمزيد

# Production defaults for the automated GitHub Actions workflow.
UPLOAD=true
YT_PRIVACY=public
YT_DAILY_LIMIT=3
LEARN_FROM_STATS=true
SYNTHETIC_MEDIA=true
KEEP_VIDEOS=true
OUTPUT_DIR=output_videos
DATA_DIR=data
TIMEZONE=Africa/Cairo

# Production slots are reference values only; workflow scheduling stays disabled.
PUBLISH_TIMES=09:00,14:00,19:00

# Comment replies remain disabled.
AUTO_REPLY_ENABLED=false
AUTO_REPLY_DAILY_LIMIT=20
